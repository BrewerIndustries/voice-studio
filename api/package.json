{
  "name": "voice-studio-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev",
    "migrate:local": "wrangler d1 migrations apply voice-studio-prod --local",
    "migrate:prod": "wrangler d1 migrations apply voice-studio-prod --remote",
    "migrate:dev": "wrangler d1 migrations apply voice-studio-dev --remote --env dev",
    "create-user": "node scripts/create-user.mjs",
    "typecheck": "tsc"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
